*.swp

# --- Security: never commit any of these ---------------------------------
# Test vaults, key material and anything that could contain real user data.
# A committed vault is a committed secret, even if it is "just a test".
*.cvf
*.cvd
*.cvn
*.cvarchive
vault.cvconf
/test-vaults/
/benchvaults/
*.key
*.pem
*.p12
*.pfx
*.jks
.env
.env.*
!.env.example

# …except the frozen format vectors, which are committed on purpose: they are
# the mechanism that stops the on-disk format changing by accident. They contain
# nothing but test data encrypted under keys published in the test source.
!crates/cv-format/tests/vectors/
!crates/cv-format/tests/vectors/**

# Build/CI local artifacts
/coverage/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/target/
*.profraw
*.profdata
